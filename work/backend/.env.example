TAPTRACE_API_KEY=replace-with-a-long-random-secret
TAPTRACE_ALLOWED_ORIGINS=https://your-frontend.example
TAPTRACE_RATE_LIMIT_PER_MINUTE=60
TAPTRACE_MAX_BODY_BYTES=10000
TAPTRACE_REDIS_URL=redis://redis:6379/0
TAPTRACE_REQUIRE_REDIS=true
TAPTRACE_RATE_KEY_SALT=replace-with-an-independent-long-random-secret
TAPTRACE_TRUST_PROXY=true
TAPTRACE_METRICS_TOKEN=internal-prometheus-only
TAPTRACE_STATE_DIR=/data
TAPTRACE_BACKUP_DIR=/backups
TAPTRACE_BACKUP_RETENTION_DAYS=14
TAPTRACE_BACKUP_INTERVAL_SECONDS=86400
TAPTRACE_REQUIRE_RECENT_BACKUP=true
TAPTRACE_BACKUP_INCLUDE_REGISTRIES=false
TAPTRACE_DOMAIN=api.example.com
# Optional offsite backups:
# TAPTRACE_BACKUP_S3_BUCKET=your-private-backup-bucket
# TAPTRACE_BACKUP_S3_PREFIX=taptrace/production
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
